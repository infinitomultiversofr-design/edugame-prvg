-- =========================================================================
-- FIXTURE COMPARTILHADA DA SUÍTE M0
--
-- Incluída por cada arquivo de teste com  \ir helpers/m0_fixture.psql
-- (caminho relativo ao arquivo que inclui, não ao diretório de trabalho).
--
-- Extensão .psql de propósito: pg_prove/`supabase test db` coletam *.sql,
-- então este arquivo nunca é executado como teste isolado.
--
-- REGRA: esta fixture NÃO desliga triggers nem FKs.
-- A versão anterior abria com `SET LOCAL session_replication_role = replica`,
-- o que desativava as FKs compostas de escopo e os triggers de vínculo —
-- exatamente as garantias que o Gate M0-A manda provar. Além disso esse
-- parâmetro exige superusuário, e o papel `postgres` do Supabase hospedado
-- não é superusuário, então a suíte só rodava em stack local.
-- Aqui os usuários são criados de verdade em auth.users e todas as
-- constraints permanecem armadas.
--
-- PRINCIPAIS
--   escola A          10000000-…-0001      escola B          20000000-…-0001
--   ano letivo A      10000000-…-0002      ano letivo B      20000000-…-0002
--   turma 6A          10000000-…-0003      turma B 6A        20000000-…-0003
--   turma 7A          10000000-…-0004
--   aluno A1          10000000-…-0011      aluno B1          20000000-…-0011
--   aluno A2          10000000-…-0012
--   user aluno A1     aaaaaaaa-…-aa01      user prof B       bbbbbbbb-…-bb10
--   user aluno A2     aaaaaaaa-…-aa02      user sem vínculo  bbbbbbbb-…-bb99
--   user prof A       aaaaaaaa-…-aa10
--   user responsável  aaaaaaaa-…-aa20
--   user coord A      aaaaaaaa-…-aa30
--   flag arena_beta   ffffffff-…-0001  (default_enabled = false)
-- =========================================================================

CREATE FUNCTION pg_temp.act_as(p_user uuid)
RETURNS void
LANGUAGE plpgsql
AS $fixture$
BEGIN
  PERFORM set_config(
    'request.jwt.claims',
    json_build_object('sub', p_user, 'role', 'authenticated')::text,
    true
  );
  PERFORM set_config('request.jwt.claim.sub', p_user::text, true);
END;
$fixture$;

